{
  "openapi": "3.0.3",
  "info": {
    "title": "Express Node Starter API",
    "version": "2.0.0",
    "description": "REST API with JWT authentication, roles, account confirmation, password reset and uploads.",
    "license": { "name": "MIT", "url": "https://spdx.org/licenses/MIT.html" },
    "contact": {
      "name": "Raed Fadhlaoui",
      "url": "https://github.com/fadhlaouir/express-node-starter"
    }
  },
  "servers": [{ "url": "/v1/api" }],
  "tags": [
    { "name": "Auth", "description": "Sign-up, sign-in and passwords" },
    { "name": "Users", "description": "Accounts and profiles" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "fullName": { "type": "string" },
          "photo": { "type": "string", "example": "uploads/3f1c….png" },
          "role": {
            "type": "string",
            "enum": ["is_user", "is_manager", "is_admin"]
          },
          "is_active": { "type": "boolean" },
          "joined_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "Message": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" }
        }
      },
      "Credentials": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string" }
        }
      },
      "SignInResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "token": { "type": "string" },
          "user": { "$ref": "#/components/schemas/User" }
        }
      },
      "Email": {
        "type": "object",
        "required": ["email"],
        "properties": { "email": { "type": "string", "format": "email" } }
      }
    },
    "responses": {
      "Message": {
        "description": "Result",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Message" }
          }
        }
      }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Create an account",
        "description": "The account is inactive until the email is confirmed. Role and activation are never taken from the request.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "minLength": 8 },
                  "fullName": { "type": "string" },
                  "photo": { "type": "string", "format": "binary" }
                }
              }
            },
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "minLength": 8 },
                  "fullName": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Message" },
          "409": { "$ref": "#/components/responses/Message" },
          "422": { "$ref": "#/components/responses/Message" }
        }
      }
    },
    "/auth/confirm/{code}": {
      "post": {
        "tags": ["Auth"],
        "summary": "Activate an account with the code sent by email",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Message" },
          "400": { "$ref": "#/components/responses/Message" }
        }
      }
    },
    "/auth/resend-confirmation": {
      "post": {
        "tags": ["Auth"],
        "summary": "Send a new confirmation email",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Email" }
            }
          }
        },
        "responses": { "200": { "$ref": "#/components/responses/Message" } }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Sign in",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Credentials" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SignInResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Message" },
          "403": { "$ref": "#/components/responses/Message" }
        }
      }
    },
    "/auth/admin/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Sign in to the back office (admins and managers)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Credentials" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SignInResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Message" },
          "403": { "$ref": "#/components/responses/Message" }
        }
      }
    },
    "/auth/forget-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Email a password reset link",
        "description": "Answers the same whether or not the email has an account.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Email" }
            }
          }
        },
        "responses": { "200": { "$ref": "#/components/responses/Message" } }
      }
    },
    "/auth/reset-password/{token}": {
      "post": {
        "tags": ["Auth"],
        "summary": "Set a new password with a reset token",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["newPassword", "verifyPassword"],
                "properties": {
                  "newPassword": { "type": "string", "minLength": 8 },
                  "verifyPassword": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Message" },
          "400": { "$ref": "#/components/responses/Message" },
          "422": { "$ref": "#/components/responses/Message" }
        }
      }
    },
    "/users/check-email": {
      "post": {
        "tags": ["Users"],
        "summary": "Check whether an email is registered",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Email" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "exists": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/users": {
      "get": {
        "tags": ["Users"],
        "summary": "List users (admins and managers)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 20, "maximum": 100 }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "users": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/User" }
                    },
                    "pagination": {
                      "type": "object",
                      "properties": {
                        "page": { "type": "integer" },
                        "limit": { "type": "integer" },
                        "total": { "type": "integer" },
                        "pages": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Message" },
          "403": { "$ref": "#/components/responses/Message" }
        }
      }
    },
    "/users/me": {
      "get": {
        "tags": ["Users"],
        "summary": "Get the signed-in user",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "The user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "user": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Message" }
        }
      }
    },
    "/users/me/password": {
      "put": {
        "tags": ["Users"],
        "summary": "Change the signed-in user's password",
        "description": "Signs out every other session. The response carries a new token for this one.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["currentPassword", "newPassword"],
                "properties": {
                  "currentPassword": { "type": "string" },
                  "newPassword": {
                    "type": "string",
                    "minLength": 8,
                    "description": "8 characters to 72 bytes"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password changed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string" },
                    "token": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Message" },
          "422": { "$ref": "#/components/responses/Message" }
        }
      }
    },
    "/users/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "get": {
        "tags": ["Users"],
        "summary": "Get a user (the user themselves, admins and managers)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "The user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "user": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "403": { "$ref": "#/components/responses/Message" },
          "404": { "$ref": "#/components/responses/Message" }
        }
      },
      "put": {
        "tags": ["Users"],
        "summary": "Update a user (the user themselves, admins and managers)",
        "description": "Users can change fullName and photo. Only admins can change role and is_active.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "fullName": { "type": "string" },
                  "photo": { "type": "string", "format": "binary" },
                  "role": {
                    "type": "string",
                    "enum": ["is_user", "is_manager", "is_admin"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Message" },
          "403": { "$ref": "#/components/responses/Message" },
          "404": { "$ref": "#/components/responses/Message" }
        }
      },
      "delete": {
        "tags": ["Users"],
        "summary": "Delete a user (the user themselves, or an admin)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "$ref": "#/components/responses/Message" },
          "403": { "$ref": "#/components/responses/Message" },
          "404": { "$ref": "#/components/responses/Message" }
        }
      }
    }
  }
}
