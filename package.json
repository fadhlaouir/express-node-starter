{
  "name": "express-node-starter",
  "version": "2.1.1",
  "description": "Secure Express 5 and MongoDB starter for REST APIs: JWT authentication, roles, account confirmation, password reset, uploads, Swagger docs, tests and a CRUD generator.",
  "main": "server.js",
  "author": "Raed Fadhlaoui <raed.fadhlaoui@hotmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/fadhlaouir/express-node-starter#readme",
  "bugs": "https://github.com/fadhlaouir/express-node-starter/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fadhlaouir/express-node-starter.git"
  },
  "funding": "https://www.buymeacoffee.com/fadhlaouir",
  "keywords": [
    "express",
    "express5",
    "mongodb",
    "mongoose",
    "rest-api",
    "jwt",
    "authentication",
    "starter",
    "boilerplate",
    "swagger"
  ],
  "files": [
    "server.js",
    "src/",
    "cli/",
    ".env.example",
    "Dockerfile",
    "docker-compose.yml"
  ],
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "crud:operation": "node cli/index.js",
    "release": "commit-and-tag-version",
    "release:minor": "commit-and-tag-version --release-as minor",
    "release:major": "commit-and-tag-version --release-as major",
    "release:dry": "commit-and-tag-version --dry-run",
    "prepare": "husky"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "commit-and-tag-version": "^13.3.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
