# Copy this file to .env and fill it in. `npm start` and `npm run dev` load it.

# DATABASE
DEV_DATABASE=mongodb://localhost:27017/express-node-starter
PROD_DATABASE=

# JWT: a long random string, at least 32 characters in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET=
JWT_EXPIRES_IN=7d

PORT=5000

# FRONT END: used in email links (confirm account, reset password)
DEVELOPMENT_CLIENT_URL=http://localhost:3000
PRODUCTION_CLIENT_URL=

# CORS: allowed origins, comma-separated, or * for any
CORS_ORIGIN=*

# Requests per IP per 15 minutes: every API route, and public auth routes
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=20

# MAILER: leave MAILER_EMAIL_ID empty to skip sending (links are printed in the console in development)
MAILER_EMAIL_ID=
MAILER_PASSWORD=
MAILER_SERVICE_PROVIDER=gmail
HOST=smtp.gmail.com
PORT_SSL=465
SECURE=true
